meta {
  name: List Notes by Tag
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/notes?tag=test
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.status).to.equal(200);
  });

  test("response is array", function() {
    expect(res.body.data).to.be.an("array");
  });

  test("all notes contain tag", function() {
    res.body.data.forEach(function(note) {
      expect(note.tags).to.include("test");
    });
  });
}