meta {
  name: Patch Note
  type: http
  seq: 5
}

patch {
  url: {{baseUrl}}/notes/{{noteId}}
  body: json
  auth: none
}

body:json {
  [
    { "op": "replace", "path": "/title", "value": "Updated via JSON Patch" },
    { "op": "replace", "path": "/color", "value": "#d4f7d4" },
    { "op": "add",     "path": "/tags/-", "value": "patched" }
  ]
}

tests {
  test("status is 204", function() {
    expect(res.status).to.equal(204);
  });
}